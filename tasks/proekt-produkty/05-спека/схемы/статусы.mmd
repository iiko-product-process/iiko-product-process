stateDiagram-v2
    state "Черновик · активна" as C
    state "Ждёт подтверждения" as W
    state "Собирается" as A
    state "Едет к вам" as T
    state "Ждёт приёмки" as D
    state "Завершена" as F
    state "Срок истёк" as E
    state "Отменена" as X
    [*] --> C: создана
    C --> W: оформлена
    W --> A: поставщик подтвердил
    W --> E: нет ответа в срок
    E --> A: подтвердил после напоминания
    E --> X: выбрали другого / отменили
    A --> T: передан в доставку
    T --> D: доставлено
    D --> F: принято
    C --> X: отменена
    A --> X: отменена
    F --> [*]
    X --> [*]
